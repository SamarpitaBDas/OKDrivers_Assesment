<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensor Test"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/ok_text"/>

        <TextView
            android:id="@+id/tvSensorStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Starting sensors..."
            android:textSize="16sp"
            android:textColor="@color/ok_secondary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Accelerometer"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/ok_text"/>

        <TextView
            android:id="@+id/tvAccelerationX"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="X: 0.000 m/s²"
            android:textSize="17sp"/>

        <TextView
            android:id="@+id/tvAccelerationY"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Y: 0.000 m/s²"
            android:textSize="17sp"/>

        <TextView
            android:id="@+id/tvAccelerationZ"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Z: 0.000 m/s²"
            android:textSize="17sp"/>

        <TextView
            android:id="@+id/tvGForce"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="G-force: 0.000 G"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Gyroscope"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/ok_text"/>

        <TextView
            android:id="@+id/tvGyroX"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="X: 0.0000 rad/s"
            android:textSize="17sp"/>

        <TextView
            android:id="@+id/tvGyroY"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Y: 0.0000 rad/s"
            android:textSize="17sp"/>

        <TextView
            android:id="@+id/tvGyroZ"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Z: 0.0000 rad/s"
            android:textSize="17sp"/>

    </LinearLayout>

</ScrollView>