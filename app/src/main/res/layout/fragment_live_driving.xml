<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/ok_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="← Back"
            android:textColor="@color/ok_green_light"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Live Driving Telemetry"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/logo" android:scaleType="centerInside" android:alpha="0.18"
            android:contentDescription="Driving camera preview"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_margin="14dp" android:text="● REC" android:textColor="@android:color/white"
            android:background="@color/ok_red" android:padding="8dp"/>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView
            android:id="@+id/tvTelemetryPrimary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="-- km/h                         RPM ----"
            android:textColor="@android:color/white" android:textSize="18sp"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" app:cardCornerRadius="16dp">
            <TextView
                android:id="@+id/tvTelemetrySecondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="18dp" android:text="G-Force: -- G       Heading: --°\nLocation: Acquiring GPS..."
                android:textColor="@color/ok_text"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
