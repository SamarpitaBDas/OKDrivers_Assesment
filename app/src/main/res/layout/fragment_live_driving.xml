<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/ok_dark">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/logo" android:scaleType="centerInside" android:alpha="0.18"
            android:contentDescription="Driving camera preview"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_margin="14dp" android:text="● REC" android:textColor="@android:color/white"
            android:background="@color/ok_red" android:padding="8dp"/>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="48 km/h                         RPM 1820"
            android:textColor="@android:color/white" android:textSize="18sp"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" app:cardCornerRadius="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="18dp" android:text="● Driver State   Attentive

G-Force  0.12 G       Heading  NE (45°)"
                android:textColor="@color/ok_text"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
