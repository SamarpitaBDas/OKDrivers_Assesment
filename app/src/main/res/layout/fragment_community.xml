<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ok_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/tvCommunityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Community"
            android:textColor="@color/ok_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCommunitySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your local driver safety network"
            android:textColor="@color/ok_secondary"
            android:textSize="14sp" />


        <!-- ========================= -->
        <!-- COMMUNITY STATUS -->
        <!-- ========================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCommunityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/ok_green"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#4F9D80"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Community Active"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCommunityActive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="12 responders nearby"
                        android:textColor="#E4F5EE"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ========================= -->
        <!-- NEARBY RESPONDERS -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/tvNearbyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Nearby Responders"
            android:textColor="@color/ok_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNearbySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="People available to help in your area"
            android:textColor="@color/ok_secondary"
            android:textSize="13sp" />


        <!-- ========================= -->
        <!-- RESPONDER 1 -->
        <!-- ========================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResponderRavi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8E3"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="15dp">

                <!-- Avatar -->

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="#DDEDE6"
                    android:gravity="center"
                    android:text="RK"
                    android:textColor="@color/ok_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ravi Kumar"
                        android:textColor="@color/ok_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="2.4 km  •  3 min ETA"
                        android:textColor="@color/ok_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="●  Active  •  Reputation 4.8"
                        android:textColor="@color/ok_green"
                        android:textSize="12sp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRaviView"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="View"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="21dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ========================= -->
        <!-- RESPONDER 2 -->
        <!-- ========================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResponderNeha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8E3"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="#DDEDE6"
                    android:gravity="center"
                    android:text="NS"
                    android:textColor="@color/ok_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Neha Singh"
                        android:textColor="@color/ok_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="4.7 km  •  6 min ETA"
                        android:textColor="@color/ok_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="●  Active  •  Reputation 4.5"
                        android:textColor="@color/ok_green"
                        android:textSize="12sp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNehaView"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="View"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="21dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ========================= -->
        <!-- RESPONDER 3 -->
        <!-- ========================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResponderArjun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8E3"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="#DDEDE6"
                    android:gravity="center"
                    android:text="AM"
                    android:textColor="@color/ok_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arjun Mehta"
                        android:textColor="@color/ok_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="6.2 km  •  9 min ETA"
                        android:textColor="@color/ok_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="●  Active  •  Reputation 4.2"
                        android:textColor="@color/ok_green"
                        android:textSize="12sp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnArjunView"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="View"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="21dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ========================= -->
        <!-- COMMUNITY SAFETY -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/tvSafetyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Community Safety"
            android:textColor="@color/ok_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSafety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="100dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8E3"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You're part of the safety network"
                    android:textColor="@color/ok_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSafetyDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Nearby responders can be notified when an emergency requires community assistance."
                    android:textColor="@color/ok_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewAllResponders"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="View All Responders"
                    android:textAllCaps="false"
                    app:cornerRadius="25dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>